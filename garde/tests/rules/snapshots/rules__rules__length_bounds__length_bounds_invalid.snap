LengthBoundsTest {
    inclusive_range: "hi",
    exclusive_range: "test",
    start_only: [
        1,
        2,
        3,
    ],
    end_only: "short",
    bytes_range: "hello",
    chars_range: "world",
}
inclusive_range: length is lower than 5
start_only: length is lower than 10

